  <name>WeekPlan</name>
  <summary>A beautiful, fast, week-at-a-glance calendar</summary>
  <description>
    <p>WeekPlan is a lightweight calendar for GNOME focused on the current week. It shows what's happening right now, what's coming up next, and helps you plan ahead without distractions.</p>
    <p>Features:</p>
    <ul>
      <li>Live now-line and progress bars</li>
      <li>Weekly view with all 7 days and 24 hours</li>
      <li>Recurring events: daily, weekly, weekdays, custom RRULE</li>
      <li>Native GNOME notifications</li>
      <li>Two-way Google Calendar sync</li>
      <li>Light and dark mode support</li>
      <li>Lightweight — under 80 MB RAM</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.weekplan.app.desktop</launchable>
